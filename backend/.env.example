PORT=5001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=glowy_saloon
DB_USER=root
DB_PASSWORD=your_password

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Email / 2FA OTP (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Thermal Printer (USB ESC/POS)
THERMAL_PRINTER_ENABLED=true
# Optional: specify USB Vendor ID and Product ID (hex) to target a specific printer
# THERMAL_PRINTER_VID=0x0416
# THERMAL_PRINTER_PID=0x5011

# ── Meta WhatsApp Business Cloud API ──────────────────────────────
WHATSAPP_ENABLED=true
# Phone Number ID from Meta Developer Console (WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=
# Permanent User or System Access Token from Meta Developer Portal
WHATSAPP_ACCESS_TOKEN=
# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional: Meta Approved Template Name (leave empty for dynamic text receipts)
WHATSAPP_TEMPLATE_NAME=
# Default country code prefix for phone numbers (e.g. 91 for India)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

