PORT=5001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=glowy_saloon
DB_USER=root
DB_PASSWORD=your_password

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# Email / 2FA OTP (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Thermal Printer (USB ESC/POS)
THERMAL_PRINTER_ENABLED=true
# Optional: specify USB Vendor ID and Product ID (hex) to target a specific printer
# THERMAL_PRINTER_VID=0x0416
# THERMAL_PRINTER_PID=0x5011
